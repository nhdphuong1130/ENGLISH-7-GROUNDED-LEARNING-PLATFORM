ENGLISH7_SERVICE_NAME=english7-api
ENGLISH7_API_PREFIX=/api/v1

COMPOSE_PROJECT_NAME=english7
API_HOST_PORT=8000

SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
SQLSERVER_EDITION=Developer
SQLSERVER_HOST_PORT=1433
SQLSERVER_SA_PASSWORD=ChangeThis_LocalOnly_123!
SQLSERVER_DATABASE=english7
ENGLISH7_DATABASE_URL=mssql+pyodbc://sa:ChangeThis_LocalOnly_123!@sqlserver:1433/english7?driver=FreeTDS&TDS_Version=8.0
ENGLISH7_JWT_SECRET=ReplaceWithAtLeast32RandomCharacters
ENGLISH7_JWT_ALGORITHM=HS256
ENGLISH7_ACCESS_TOKEN_MINUTES=30
ENGLISH7_WORKER_POLL_INTERVAL_SECONDS=2

NEO4J_IMAGE=neo4j:5.26-community
NEO4J_USER=neo4j
NEO4J_PASSWORD=ChangeThis_LocalOnly_456!
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
ENGLISH7_NEO4J_URI=bolt://neo4j:7687
ENGLISH7_NEO4J_USER=neo4j
ENGLISH7_NEO4J_PASSWORD=ChangeThis_LocalOnly_456!
ENGLISH7_NEO4J_VECTOR_INDEX=source_fragment_embedding
ENGLISH7_EMBEDDING_PROVIDER=fastembed
ENGLISH7_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENGLISH7_EMBEDDING_MODEL_VERSION=fastembed-catalog-2026-09
ENGLISH7_EMBEDDING_DIMENSIONS=384
ENGLISH7_EMBEDDING_CACHE_DIR=/app/cache/fastembed
ENGLISH7_EMBEDDING_BATCH_SIZE=32
ENGLISH7_EMBEDDING_QUERY_PREFIX=
ENGLISH7_EMBEDDING_PASSAGE_PREFIX=
ENGLISH7_EMBEDDING_PREPROCESSING_VERSION=v1
ENGLISH7_KNOWLEDGE_GRAPH_INDEX_TIMEOUT_SECONDS=60
ENGLISH7_RETRIEVAL_TOP_K=8
ENGLISH7_RETRIEVAL_MIN_SCORE=0.65
ENGLISH7_RETRIEVAL_GRAPH_DEPTH=2
ENGLISH7_RETRIEVAL_RRF_CONSTANT=60
ENGLISH7_RETRIEVAL_MAX_CONTEXT_FRAGMENTS=6
ENGLISH7_RETRIEVAL_ALLOWED_UNITS=1,2

ENGLISH7_OPENROUTER_API_KEY=replace-with-your-openrouter-key
ENGLISH7_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
ENGLISH7_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
ENGLISH7_OPENROUTER_TIMEOUT_SECONDS=30
ENGLISH7_OPENROUTER_EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
ENGLISH7_OPENROUTER_EMBEDDING_MODEL=replace-with-configured-embedding-model
ENGLISH7_TUTOR_QUERY_MAX_CHARACTERS=4000
ENGLISH7_QUIZ_DUPLICATE_THRESHOLD=0.85
ENGLISH7_QUIZ_MAX_AUDIO_PLAYS=2

ENGLISH7_INGESTION_DEVICE=cpu
ENGLISH7_LAYOUT_MODEL_ID=juliozhao/DocLayout-YOLO-DocStructBench
ENGLISH7_LAYOUT_CONFIDENCE_THRESHOLD=0.60
ENGLISH7_OCR_ENGINE=paddleocr
ENGLISH7_OCR_VERSION=PP-OCRv5
ENGLISH7_INGESTION_VERSION=replace-with-pipeline-version
ENGLISH7_SOURCE_OBJECT_PREFIX=sources
ENGLISH7_UPLOAD_MAX_BYTES=20971520
ENGLISH7_IMAGE_UPLOAD_PREFIX=student-images
ENGLISH7_IMAGE_UPLOAD_RETENTION_MINUTES=60
ENGLISH7_IMAGE_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
ENGLISH7_OCR_LANGUAGES=en,vi
ENGLISH7_OCR_MINIMUM_CONFIDENCE=0.60

MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=english7-local
MINIO_ROOT_PASSWORD=ChangeThis_LocalOnly_789!
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_MEDIA_BUCKET=english7-media
MINIO_UPLOAD_BUCKET=english7-uploads

# Twilio SMS OTP Configuration
ENGLISH7_TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
ENGLISH7_TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
ENGLISH7_TWILIO_FROM_PHONE=+10000000000

# Android Real SIM SMS Gateway Configuration
# Local: http://127.0.0.1:8080. EC2: use the phone's HTTPS tunnel URL.
ENGLISH7_SMS_GATEWAY_URL=http://127.0.0.1:8080
ENGLISH7_SMS_GATEWAY_USERNAME=sms
ENGLISH7_SMS_GATEWAY_PASSWORD=replace_with_gateway_password

# ClickSend Voice Call OTP Configuration
ENGLISH7_CLICKSEND_USERNAME=replace_with_clicksend_username
ENGLISH7_CLICKSEND_API_KEY=replace_with_clicksend_api_key



