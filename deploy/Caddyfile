    handle_path /app/* {
        root * /var/www/english7-pwa/current
        try_files {path} /index.html

        @mutable path /index.html /manifest.json /service-worker.js /flutter_bootstrap.js
        header @mutable Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    handle_path /downloads/* {
        root * /var/www/english7-downloads
        header Content-Disposition "attachment"
        file_server
    }

    handle {
        reverse_proxy 127.0.0.1:8000
    }
}
